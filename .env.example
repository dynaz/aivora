OPENAI_MODEL=
PORT=3000
AIVORA_DB=data/aivora.sqlite
# Devnet only. Public addresses, not private keys.
AIVR_DEVNET_MINT=
AIVR_DEVNET_RECIPIENT_TOKEN_ACCOUNT=
