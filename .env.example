# Copy to .env; do not commit actual credentials.

# Deployment mode: development (default) or production. In production the service refuses to start
# unless the https canonical origin and trusted proxy below are set (fail-safe).
AIVORA_ENV=development
# Public origin the site is served at: scheme://host[:port], no path. Required in production.
# Example (do not enable until DNS/origin + HTTPS are verified): https://store.terminow.online
AIVORA_CANONICAL_ORIGIN=
# Bind address. Keep loopback in production; the reverse proxy (LiteSpeed) is the public entry point.
AIVORA_BIND_HOST=127.0.0.1
# Set to 1 only when running behind a trusted reverse proxy that terminates TLS on loopback.
AIVORA_TRUST_PROXY=0

AIVORA_AI_MODE=demo
OPENAI_API_KEY=
# Required only in openai mode; choose a model your API account supports.
OPENAI_MODEL=
PORT=3000
AIVORA_DB=data/aivora.sqlite
# Devnet only. Public addresses, not private keys.
AIVR_DEVNET_MINT=
AIVR_DEVNET_RECIPIENT_TOKEN_ACCOUNT=

# Entitlement delivery to the TermiNow backend. 'log' (default) records locally; 'http' POSTs each grant
# to TERMINOW_ENTITLEMENT_URL with a server-only bearer key — this key is NEVER shipped in the mobile app.
AIVORA_DELIVERY_MODE=log
TERMINOW_ENTITLEMENT_URL=
TERMINOW_ENTITLEMENT_KEY=
