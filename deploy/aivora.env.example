# Aivora Store — server EnvironmentFile template.
#
# Install as /etc/aivora/aivora.env, owned by the aivora user, mode 0600 (NEVER world-readable, NEVER in
# the repo). scripts/deploy.sh creates it from this template on first deploy if it is missing, then stops
# so you can fill in the real values. systemd reads this file via EnvironmentFile=.

# Production fails safe: it will NOT start unless the https canonical origin and trusted proxy are set.
AIVORA_ENV=production

# The public origin the site is served at, scheme://host (no path, no trailing slash). Secure cookies and
# the allowed Host/Origin are derived from this — never from forwarded headers.
# Do NOT set a production hostname until DNS/origin + HTTPS are verified.
AIVORA_CANONICAL_ORIGIN=https://__DOMAIN__

# Behind LiteSpeed on loopback: trust the proxy and bind loopback only.
AIVORA_TRUST_PROXY=1
AIVORA_BIND_HOST=127.0.0.1
# Unused loopback port; must match extprocessor address in deploy/litespeed-vhost.conf.
PORT=__AIVORA_PORT__

# Database + backups live outside the repo on a writable path (matches systemd ReadWritePaths).
AIVORA_DB=/var/lib/aivora/aivora.sqlite

# AI provider (demo keeps the storefront self-contained; openai requires a key).
AIVORA_AI_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Solana Devnet (public addresses ONLY — never a private key here). Mainnet stays disabled. ---
# Missing mint or recipient disables checkout (fail-safe), it does not fall back to an insecure default.
AIVR_DEVNET_MINT=
AIVR_DEVNET_RECIPIENT_TOKEN_ACCOUNT=

# --- Entitlement delivery to the TermiNow backend (server-to-server). ---
# 'log' records deliveries locally (sandbox). 'http' POSTs to TERMINOW_ENTITLEMENT_URL with a server-only
# bearer key. This key is NEVER shipped in the mobile app.
AIVORA_DELIVERY_MODE=log
TERMINOW_ENTITLEMENT_URL=
TERMINOW_ENTITLEMENT_KEY=
