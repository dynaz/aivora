# TermiNow Store — unprivileged systemd service.
#
# Install to /etc/systemd/system/aivora.service (scripts/deploy.sh does this). The service runs as the
# dedicated, unprivileged `aivora` user, binds loopback only (the public entry point is LiteSpeed in
# front of it — see deploy/litespeed-vhost.conf), and reads secrets from an EnvironmentFile that lives
# outside the repository at /etc/aivora/aivora.env (mode 0600).
#
# Adjust ExecStart if `node` is not at /usr/bin/node on this host (run `command -v node`).

[Unit]
Description=TermiNow Store (TermiNow Premium storefront)
Documentation=https://github.com/dynaz/aivora
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aivora
Group=aivora
WorkingDirectory=/opt/aivora
EnvironmentFile=/etc/aivora/aivora.env
ExecStart=/usr/bin/node src/server.mjs
Restart=on-failure
RestartSec=2
TimeoutStartSec=20

# --- Hardening: least privilege for a network service that only needs its data directory. ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The ONLY writable path: the SQLite database + backups directory (AIVORA_DB must point inside it).
ReadWritePaths=/var/lib/aivora
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
